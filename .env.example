# ==============================================================================
# CONCECT FINANÇAS — VARIÁVEIS DE AMBIENTE (.env)
# Copie este arquivo para .env na raiz de concect-financas/ e preencha suas chaves.
# Nunca faça commit do arquivo .env com credenciais reais.
# ==============================================================================

# Frontend (Vite) — Chave da API Groq para Consultor IA e Simulador WhatsApp
# Também pode ser configurada em runtime na tela Configurações > Chave de API
VITE_GROQ_API_KEY=gsk_sua_chave_groq_aqui

# Backend Bot WhatsApp (whatsapp-server.js)
GROQ_API_KEY=gsk_sua_chave_groq_aqui
BOT_EMAIL=bot@concectfinancas.com
BOT_PASSWORD=sua_senha_segura_do_bot
WHATSAPP_PORT=3001
